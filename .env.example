# Supabase project settings (Settings -> API in the Supabase dashboard).
# Use the publishable key here, never the secret key — this ships in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Express backend URL. Use your machine's LAN IP for physical devices
# (localhost only works from an iOS simulator, and 10.0.2.2 for Android emulator).
EXPO_PUBLIC_API_URL=http://localhost:3000

